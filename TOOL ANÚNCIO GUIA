-- Função para criar os blocos de texto (Com fonte maior e mais legível)
local function createLabel(text, size, alignment, order)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -8, 0, 0) -- Largura ajustada para o scroll
    label.AutomaticSize = Enum.AutomaticSize.Y
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = Color3.fromRGB(255, 255, 255)
    label.TextSize = size
    label.Font = Enum.Font.Arcade
    label.TextWrapped = true
    label.TextXAlignment = alignment
    label.LayoutOrder = order
    label.Parent = scrollFrame
    return label
end

-- Conteúdo com texto completo e correção ortográfica
